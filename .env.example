# Número de WhatsApp del negocio (solo dígitos, sin +). Ejemplo Colombia: 57 + celular.
VITE_WHATSAPP_APEX=573001234567

# URL pública del sitio (canonical, Open Graph, Search Console).
# Tiene que ser un dominio REAL con DNS y HTTPS, con esquema, sin barra final. Ejemplo:
#   VITE_SITE_URL=https://apex.com.co
# En el navegador probá: https://TU_DOMINIO_REAL/sitemap.xml (no uses "tu_dominio" como texto).
#
# Si no está definido: /sitemap.xml y /robots.txt usan el host de la petición; el canonical
# en HTML solo aparece en desarrollo (localhost) o cuando exista esta variable.
#
# --- Ciberseguridad (recordatorio) ---
# El JavaScript del cliente siempre es visible ("Inspeccionar" / red). Eso es normal.
# Lo que no debe exponerse nunca: claves de API, service role de Supabase, PIN admin → solo servidor / secretos de GitHub–Cloudflare, nunca prefijo VITE_*.
# Capa extra: en Cloudflare activá WAF / bot fight, límites de tasa y reglas para rutas sensibles.

# Variables SOLO servidor (local: .dev.vars o entorno; producción: GitHub Secrets → ver docs/github-actions-deploy.md)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxxxx (NUNCA en el frontend / NUNCA VITE_*)
#
# Panel /admin (solo servidor; no usar VITE_*). Pruebas: Panel1234
# ADMIN_PIN=Panel1234
#
# Notificaciones push PWA (generar con: npm run vapid:keys)
# VITE_VAPID_PUBLIC_KEY=...   (build / cliente)
# VAPID_PUBLIC_KEY=...        (Worker, mismo valor que la pública)
# VAPID_PRIVATE_KEY=...       (Worker, NUNCA en VITE_*)
# VAPID_SUBJECT=mailto:contacto@tu-dominio.com
#
# Cuando tengas la SQL aplicada en Supabase, podés cargar el catálogo JSON a la tabla productos:
#   npm run sync:inventory
# (usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY del mismo archivo o del entorno)
#
# --- Producción (solo claves en GitHub, sin tocar Cloudflare por variable) ---
# Repo → Settings → Secrets and variables → Actions. Nombres exactos:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
#   VITE_WHATSAPP_APEX, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_PIN
# Detalle: docs/github-actions-deploy.md
