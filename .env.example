# Número de WhatsApp del negocio (solo dígitos, sin +). Ejemplo Colombia: 57 + celular.
VITE_WHATSAPP_APEX=573001234567

# Variables SOLO servidor (local: .dev.vars o entorno; producción: GitHub Secrets → ver docs/github-actions-deploy.md)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxxxx (NUNCA en el frontend / NUNCA VITE_*)
#
# Panel /admin (solo servidor; no usar VITE_*). Pruebas: Panel1234
# ADMIN_PIN=Panel1234
#
# Cuando tengas la SQL aplicada en Supabase, podés cargar el catálogo JSON a la tabla productos:
#   npm run sync:inventory
# (usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY del mismo archivo o del entorno)
#
# --- Producción (solo claves en GitHub, sin tocar Cloudflare por variable) ---
# Repo → Settings → Secrets and variables → Actions. Nombres exactos:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
#   VITE_WHATSAPP_APEX, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_PIN
# Detalle: docs/github-actions-deploy.md
